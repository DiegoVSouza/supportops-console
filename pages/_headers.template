/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${OIDC_ORIGIN}; frame-src ${OIDC_ORIGIN}; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/config.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
