{
  "name": "supportops-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e e2e-offline scripts",
    "test": "vitest run",
    "contract:gen": "openapi-typescript contract/p05-openapi.json -o src/api/schema.d.ts",
    "contract:check": "node scripts/contract-check.mjs",
    "budget": "node scripts/budget.mjs",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --config playwright.offline.config.ts",
    "build:pages": "npm run build && node scripts/pages.mjs build"
  },
  "dependencies": {
    "colagem-ui": "file:vendor/colagem-ui-0.4.4.tgz",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
